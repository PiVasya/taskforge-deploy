COMPOSE_PROJECT_NAME=taskforge-prod
IMAGE_REPOSITORY=ghcr.io/pivasya/taskforge
IMAGE_TAG=develop
ASPNETCORE_ENVIRONMENT=Production
TASKFORGE_DEBUG_LOGS=1
DOMAIN=taskforge.by
CT_DOMAIN=ct.taskforge.by
# Optional Cloudflare DNS failover settings. The API token itself is NEVER stored here.
# If CLOUDFLARE_ZONE_ID is empty, setup discovers it and the token also needs Zone:Zone:Read.
CLOUDFLARE_ZONE=taskforge.by
CLOUDFLARE_ZONE_ID=
# Default when empty: DOMAIN and CT_DOMAIN. Add s3.taskforge.by only if that hostname really uses the same configured public origins.
CLOUDFLARE_FAILOVER_HOSTS=taskforge.by,ct.taskforge.by
LETSENCRYPT_EMAIL=admin@taskforge.by
TASKFORGE_ACME_ROUTE_WAIT_SECONDS=30
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_HA_IMAGE=ghcr.io/pivasya/taskforge/postgres-ha:develop
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=CHANGE_ME
TASKFORGE_REPLICATION_USER=taskforge_repl
TASKFORGE_REPLICATION_PASSWORD=CHANGE_ME
TASKFORGE_REWIND_USER=taskforge_rewind
TASKFORGE_REWIND_PASSWORD=CHANGE_ME
RABBITMQ_BIND=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=taskforge
RABBITMQ_DEFAULT_PASS=CHANGE_ME
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=taskforge
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
S3_BUCKET=taskforge-files
S3_PUBLIC_ENDPOINT=https://s3.taskforge.by
S3_INTERNAL_ENDPOINT=http://minio:9000
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_64_CHARS
JWT_ISSUER=TaskForge
JWT_AUDIENCE=TaskForge
TASKFORGE_INTERNAL_KEY=CHANGE_ME_AT_LEAST_40_CHARS
TASKFORGE_AGENT_INTERNAL_KEY=CHANGE_ME_AGENT_KEY
WATCHTOWER_SCOPE=taskforge-prod
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_INCLUDE_STOPPED=true
WATCHTOWER_REVIVE_STOPPED=false
WATCHTOWER_CLEANUP=true
DOCKER_API_VERSION=1.40

# HA liveness / telemetry (managed defaults)
# /ha/live is cheap and frequent; full /ha/telemetry is intentionally less frequent.
TASKFORGE_CLUSTER_TELEMETRY_POLL_SECONDS=5
TASKFORGE_CLUSTER_TELEMETRY_FETCH_SECONDS=10
TASKFORGE_CLUSTER_NODE_DOWN_AFTER_SECONDS=60
TASKFORGE_CLUSTER_LIVE_TIMEOUT_SECONDS=2
TASKFORGE_CLUSTER_TELEMETRY_TIMEOUT_SECONDS=8

# r57 public route / certificate sequencing (defaults; optional overrides).
# Never replace an existing production env with this example.
# TASKFORGE_EDGE_SETTLE_SECONDS=15
# TASKFORGE_ACME_ROUTE_WAIT_SECONDS=180
# TASKFORGE_EDGE_PROBE_INTERVAL_SECONDS=5
# TASKFORGE_EDGE_ROUTE_CONFIRMATIONS=3
# TASKFORGE_CERTBOT_TIMEOUT_SECONDS=240

# Optional 1C:Enterprise execution with server-side auto-install into persistent volumes.
# Enable only after setting an exact platform version + installer SHA-256 and a source URL/file.
ONEC_ENABLED=false
ONEC_PLATFORM_VERSION=
ONEC_INSTALL_SOURCE=auto
ONEC_INSTALL_URL=
ONEC_INSTALL_FILE=/etc/taskforge/onec/installer.run
ONEC_INSTALL_SHA256=
ONEC_INSTALL_COMPONENTS=client_full,client_thin_fib,ru
ONEC_DRIVER=/opt/taskforge/onec/driver
ONEC_EXECUTABLE=/opt/1cv8/taskforge/1cv8
ONEC_RUNNER_MEM_LIMIT=1536m
ONEC_RUNNER_PIDS_LIMIT=128
ONEC_RUNNER_CPUS=1.0
ONEC_RUNNER_SLOTS=1
ONEC_RUNNER_TMPFS_SIZE=128m
ONEC_TEMPLATE_DIR=/opt/taskforge/onec/runtime/templates/code
ONEC_JUDGE_SOURCE_DIR=/opt/taskforge/onec/judge-src
ONEC_USE_XVFB=true
ONEC_UI_LANGUAGE=ru
ONEC_LICENSE_DIR=/etc/taskforge/onec/licenses
TASKFORGE_ONEC_WORK_DIR=/var/lib/taskforge/onec-work
ONEC_DISTRIBUTION_BUCKET=taskforge-runtime-cache
ONEC_DISTRIBUTION_CHUNK_SIZE_MB=32
ONEC_DISTRIBUTION_MAX_SEEDS=4
ONEC_DISTRIBUTION_PARALLEL=4
ONEC_DISTRIBUTION_STATE_DIR=/var/lib/taskforge/onec-distribution

# Optional isolated educational SQL execution (not the business/Patroni database).
# A/B full only in standalone r66; C/lite is disabled by its profile.
SQL_ENABLED=true
SQL_CONCURRENCY=2
SQL_POOL_MAX_READY=6
SQL_POOL_MAX_MATERIALIZATIONS=4
SQL_POSTGRES_MEM_LIMIT=768m
SQL_MYSQL_MEM_LIMIT=1024m
SQL_WORKER_MEM_LIMIT=768m
SQL_POSTGRES_CPUS=0.75
SQL_MYSQL_CPUS=0.75
SQL_WORKER_CPUS=0.75
# Runtime passwords/marker and exact image digest pins are generated locally.

# Cluster diagnostics archives stored in MinIO
CLUSTER_DIAGNOSTICS_RETENTION_DAYS=7
CLUSTER_DIAGNOSTICS_S3_PREFIX=cluster-diagnostics

# Application image reconciliation in the existing Node Agent. Data engines are protected.
TASKFORGE_UPDATE_POLL_SECONDS=300
